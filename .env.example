# PromptShield AI - environment variables
# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini API key (get from Google AI Studio). All model calls happen on the backend only.
GEMINI_API_KEY=
# Model names - NOT hardcoded in code. Set these to model names from Google AI Studio.
GEMINI_TARGET_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro
GOOGLE_GENAI_API_VERSION=beta

# Database URL. SQLite by default; switch to Postgres without code changes.
DATABASE_URL=sqlite:///./promptshield.db

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional access code required by frontend for model-calling endpoints (quota abuse protection)
APP_ACCESS_CODE=

# Quota protection
REQUEST_DELAY_SECONDS=4
MAX_TESTS_PER_RUN=15
DAILY_CALL_CAP=100

# Max prompt length and request body size
MAX_PROMPT_LENGTH=4000
MAX_REQUEST_BODY_SIZE=1048576